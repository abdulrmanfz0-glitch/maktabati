{
  "name": "maktabati",
  "version": "0.1.0",
  "description": "Arabic-first local reading environment with a built-in reader, study tools, ambient sounds, and a bring-your-own-key AI companion.",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulrmanfz0-glitch/maktabati.git"
  },
  "bugs": {
    "url": "https://github.com/abdulrmanfz0-glitch/maktabati/issues"
  },
  "homepage": "https://github.com/abdulrmanfz0-glitch/maktabati#readme",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "scripts": {
    "dev": "vite apps/web",
    "build": "npm run build:web && npm run check:fonts && npm run build:single",
    "build:web": "vite build apps/web",
    "check:fonts": "node tools/check-fonts.mjs",
    "build:single": "vite build apps/web --mode worker && vite build apps/web --mode single",
    "preview": "vite preview apps/web --outDir ../../dist/web",
    "test": "vitest run",
    "bench:ui": "node tools/bench-ui.mjs"
  }
}
